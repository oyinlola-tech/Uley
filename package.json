{
  "name": "uley-student-accommodation-api",
  "version": "0.1.0",
  "private": true,
  "description": "Student accommodation platform backend API",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
