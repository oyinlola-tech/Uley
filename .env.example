NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_housing
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_DAYS=30
# Optional in development; recovery codes are logged to the API terminal when SMTP is unset.
# Configure all five values for production SMTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Internal Python media safety service. Keep this token private and at least 32 characters.
MEDIA_SERVICE_URL=http://localhost:8020
MEDIA_SERVICE_API_KEY=replace-with-a-random-secret-at-least-32-characters
MEDIA_UPLOAD_TEMP_DIRECTORY=.data/media-uploads
# Bachs hosted checkout. Use the sandbox key and webhook secret locally.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# Defaults to sandbox outside production and live API in production.
BACHS_API_BASE_URL=
WEB_APP_BASE_URL=http://localhost:3000
# Optional Expo Push API access token if enhanced push security is enabled for the EAS project.
EXPO_PUSH_ACCESS_TOKEN=
# Local file storage keeps 1 MiB chunks on this API instance; for horizontal scaling choose s3.
# MEDIA_STORAGE_BACKEND must match the media service's MEDIA_STORAGE_BACKEND setting.
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_STORAGE_PATH=/data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8020
# Private S3-compatible object storage (required only when MEDIA_STORAGE_BACKEND=s3).
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Used only by the explicit first-administrator provisioning command.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=
